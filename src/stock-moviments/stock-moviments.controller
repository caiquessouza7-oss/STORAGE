import type { NextFunction, Request, Response } from 'express';
import { BadRequestError } from '../errors/AppError';
import * as movementsService from './stock-movements.service';

function parseId(value: string): number {
  const id = Number(value);
  if (!Number.isInteger(id) || id < 1) throw new BadRequestError('itemId deve ser um ID positivo.');
  return id;
}

export async function list(req: Request, res: Response, next: NextFunction) {
  try {
    let movementType: 'in' | 'out' | undefined;
    if (req.query.type !== undefined) {
      if (req.query.type !== 'in' && req.query.type !== 'out') {
        throw new BadRequestError('type deve ser in ou out.');
      }
      movementType = req.query.type;
    }
    const itemId = req.query.itemId === undefined ? undefined : parseId(String(req.query.itemId));
    res.json(await movementsService.listAll({ itemId, movementType }));
  } catch (error) { next(error); }
}
